// config.h — wersja 2 (12.09.2026)
// Od wersji 2 WiFi, dane Supla i adresy rolet konfiguruje sie w PANELU WWW
// (tryb konfiguracji: pierwsze uruchomienie lub przytrzymanie przycisku BOOT).
// Tutaj zostaja tylko piny sprzetowe.
#pragma once

// ==== Piny CC1101 (domyślne jak w ESPSomfy-RTS dla klasycznego ESP32) ====
#define RADIO_SCK   18
#define RADIO_MISO  19
#define RADIO_MOSI  23
#define RADIO_CSN   5
#define RADIO_GDO0  13

// ==== Status LED (niebieska LED na płytce DevKit) ====
#define STATUS_LED_GPIO 2

// ==== Przycisk CONFIG (przytrzymanie = wejscie w panel WWW) ====
#define CONFIG_BUTTON_GPIO 0   // przycisk BOOT na DevKit
